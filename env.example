# SponsorFit Environment Variables
#
# When QLOO_API_KEY is omitted, SponsorFit runs in deterministic MOCK mode
# using rich taste-graph fixtures matching Qloo's official API shapes.
# Obtain a live hackathon key at:
# https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
QLOO_API_KEY=

# Optional: Google AI Studio Gemini API Key for dynamic LLM phrasing.
# When omitted, SponsorFit uses deterministic, mathematically-grounded templates.
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=

# Local server port (default 3001)
PORT=3001
